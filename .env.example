# Copy to .env.local and fill in. Never commit real values — these are read
# from the environment only (see CLAUDE.md: "Secrets/ids env uniquement").

# Public canonical site URL — used in metadata, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://screentotrip.com

# --- Stay22 (hotel meta-search affiliate; the monetization pivot) ----------
# Partner / affiliate ID from your Stay22 dashboard. Drives the <Stay22Map>
# embed and "where to stay" deeplinks. Read server-side, injected into the
# lazy iframe src.
STAY22_AID=
# Optional: LetMeAllez site-wide link rewriter ID (same Stay22 account).
# When set, outbound OTA links get auto-upgraded to affiliate deeplinks.
NEXT_PUBLIC_STAY22_LMA_ID=

# --- Activities, tickets & cars (via <AffiliateLink>) ----------------------
# Viator tours — affiliate PID (+ API key if you run the build-time sync).
VIATOR_PARTNER_PID=
VIATOR_API_KEY=
# GetYourGuide partner ID.
GETYOURGUIDE_PARTNER_ID=
# DiscoverCars affiliate ID.
DISCOVERCARS_AFFILIATE_ID=
# Tiqets partner ID.
TIQETS_PARTNER_ID=

# --- TMDB (optional) -------------------------------------------------------
# Only used by build-time scripts to enrich Title metadata. Never shipped to
# the client; the rendered data lives in /data.
TMDB_KEY=
